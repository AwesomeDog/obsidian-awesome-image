{
  "name": "obsidian-awesome-image",
  "version": "0.1.0",
  "description": "One-stop solution for image management.",
  "main": "build/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "del-cli main.js data.json build",
    "dev": "rollup --config rollup.config.mjs --watch",
    "build": "npm run clean && rollup --config rollup.config.mjs --environment BUILD:production && shx cp build/main.js ./",
    "test": "npm run typecheck && npm run build",
    "typecheck": "tsc --noEmit",
    "release": "npm run build && shx cp styles.css manifest.json build",
    "deploy": "node scripts/deploy.mjs",
    "version": "node scripts/version.mjs"
  },
  "keywords": [],
  "author": "AwesomeDog",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^26.3.0",
    "@types/safe-regex": "^1.1.6",
    "del-cli": "^7.0.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "prettier": "^3.9.6",
    "rollup": "^4.63.0",
    "rollup-plugin-esbuild": "^6.2.1",
    "shx": "^0.4.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@simonwep/pickr": "^1.10.1",
    "crypto-js": "^4.2.0",
    "file-type": "^22.0.2",
    "filenamify": "^7.0.2",
    "is-svg": "^6.1.0",
    "md5-typescript": "^1.0.5",
    "safe-regex": "^2.1.1"
  }
}
